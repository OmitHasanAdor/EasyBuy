# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/easybuy?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/easybuy?schema=public"

# ── Better Auth ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="your-better-auth-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Public URLs ──────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* values are inlined at build time: redeploy after changing them.
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
# Base URL of the easybuy-server API (required for production builds)
NEXT_PUBLIC_API_URL="http://localhost:5000"
# Public URL of this site, used for canonical/Open Graph links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Admin Seed ───────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@easybuy.com"
ADMIN_PASSWORD="adminpassword"
